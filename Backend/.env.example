# Copy to Backend/.env and fill in. NEVER commit the real .env.

# Server
PORT=3000
# Comma-separated list of allowed frontend origins (no trailing slash).
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Auth — generate a long random secret for production, e.g. `openssl rand -hex 32`
JWT_ACCESS_SECRET=change-me-in-production

# Database connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=adaptive_learning

# Two least-privilege roles the app connects as (see Backend/schema.sql).
# Local dev uses trust auth, so passwords may be empty; production MUST set them.
DB_AUTH_USER=app_auth
DB_AUTH_PASSWORD=
DB_APP_USER=app_user
DB_APP_PASSWORD=

# Owner role used only by tests/migrations to bypass RLS (defaults to your OS user).
# DB_OWNER=postgres
# DB_OWNER_PASSWORD=

# Rate limits (optional; sane defaults applied if unset)
# RATE_LIMIT_GLOBAL_MAX=300
# RATE_LIMIT_AUTH_MAX=20
